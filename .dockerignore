# Ignorar node_modules, exceto aqueles dentro de .next/standalone (que já são filtrados)
node_modules
# Ignorar logs do npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Ignorar diretório .next do build local (o build do Docker fará o seu próprio)
.next
# Ignorar arquivos de configuração de IDEs
.vscode
.idea
*.sublime-project
*.sublime-workspace
# Ignorar arquivos de sistema operacional
.DS_Store
Thumbs.db
# Ignorar arquivos .env (variáveis de ambiente devem ser passadas em runtime)
.env
.env*.local
# Arquivos de build do Docker (se estiverem no mesmo diretório)
Dockerfile
docker-compose.yml
# Arquivos específicos do Firebase App Hosting
apphosting.yaml
